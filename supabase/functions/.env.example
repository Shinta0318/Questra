# Copy to .env.beta.local and keep the copied file outside Git.
AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-server-side-secret
GEMINI_MODEL=gemini-3.5-flash
GEMINI_SEARCH_MODEL=gemini-3.5-flash
# Quest Planning roles may override a pinned primary and a distinct fallback.
# GEMINI_MODEL_MISSION_GENERATOR=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL_MISSION_GENERATOR=gemini-3.5-flash
AI_MAX_INPUT_CHARS=16000
AI_REQUEST_TIMEOUT_MS=20000
ALLOWED_WEB_ORIGINS=https://your-questra-web.example

# Server-to-server reconciliation scheduler. Keep both secrets outside clients.
AI_RECONCILIATION_WORKER_SECRET=replace-with-at-least-32-random-characters
AI_RECONCILIATION_TIMEOUT_MS=20000
# Optional privacy-safe aggregate alert webhook. HTTPS is required when enabled.
# AI_RECONCILIATION_ALERT_WEBHOOK_URL=https://alerts.example/hooks/questra
# AI_RECONCILIATION_ALERT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# OpenAI remains an explicit compatibility option. Do not configure both by default.
# AI_PROVIDER=openai
# OPENAI_API_KEY=replace-with-server-side-secret
# OPENAI_MODEL=gpt-4.1-mini
